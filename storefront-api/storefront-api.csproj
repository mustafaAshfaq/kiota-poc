<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StorefrontApi</RootNamespace>
    <Version>1.0.0</Version>

    <!-- Tests live under tests/**; keep them out of the web app compilation. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kiota runtime bundle: abstractions, HttpClient adapter, JSON/text/form/multipart
         serialization. The producers are reached only through the generated clients
         under Generated/**; there is no hand-written HTTP. -->
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="1.22.2" />
  </ItemGroup>

</Project>
